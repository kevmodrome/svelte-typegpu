{
  "name": "svelte-typegpu",
  "version": "0.0.1",
  "description": "Experimental TypeGPU/WebGPU custom renderer for Svelte.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "directory": "packages/svelte-typegpu"
  },
  "keywords": [
    "svelte",
    "webgpu",
    "typegpu",
    "renderer",
    "custom-renderer"
  ],
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/glb-test-fixtures.ts",
    "!src/test-paths.ts",
    "!src/svelte-internal-client.d.ts"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./svelte-renderer": {
      "types": "./src/svelte-renderer.ts",
      "import": "./src/svelte-renderer.ts"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "import": "./src/testing.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "svelte": ">=5.55.9 <6"
  },
  "dependencies": {
    "typegpu": "^0.11.6"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@webgpu/types": "^0.1.70",
    "svelte": "https://pkg.pr.new/svelte@18042",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  }
}
