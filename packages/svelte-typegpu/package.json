{
  "name": "svelte-typegpu",
  "version": "0.0.1",
  "description": "Experimental TypeGPU/WebGPU custom renderer for Svelte.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "directory": "packages/svelte-typegpu"
  },
  "keywords": [
    "svelte",
    "webgpu",
    "typegpu",
    "renderer",
    "custom-renderer"
  ],
  "files": [
    "compiler",
    "src",
    "!src/**/*.test.ts",
    "!src/test-fixtures",
    "!src/glb-test-fixtures.ts",
    "!src/test-paths.ts",
    "!src/component-test-utils.ts",
    "!src/viewport-test-utils.ts",
    "!src/svelte-internal-client.d.ts"
  ],
  "exports": {
    "./compiler": "./compiler/index.ts",
    "./vite": "./compiler/vite.ts",
    "./internal/viewport-canvas": "./src/ViewportCanvas.svelte",
    "./canvas": {
      "types": "./src/Canvas.svelte",
      "svelte": "./src/Canvas.svelte",
      "default": "./src/Canvas.svelte"
    },
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./svelte-renderer": {
      "types": "./src/svelte-renderer.ts",
      "import": "./src/svelte-renderer.ts"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "import": "./src/testing.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "check:svelte": "svelte-check --tsconfig type-tests/tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "svelte": ">=5.57.0 <6"
  },
  "peerDependenciesMeta": {
    "@sveltejs/vite-plugin-svelte": { "optional": true }
  },
  "dependencies": {
    "@jridgewell/remapping": "^2.3.5",
    "@typegpu/noise": "^0.11.0",
    "acorn": "^8.18.0",
    "magic-string": "^1.2.3",
    "typegpu": "^0.11.6"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^24.10.1",
    "@webgpu/types": "^0.1.70",
    "happy-dom": "^20.14.0",
    "svelte": "https://pkg.svelte.dev/svelte/c/17e37a51bc539cdb6a923b424e5746fc6505ba89",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  }
}
